# Dependências (sem barra final também cobre o symlink local backend/node_modules)
node_modules
backend/node_modules

# Variáveis de ambiente e segredos
.env
.env.*
backend/.env
backend/.env.*
!backend/.env.example
!.env.example

# Sistema e caches temporários
.DS_Store
*.log

# Cópias de segurança locais (reindexação e correções)
backend/backups/
backend/vector_store_cache*.anterior.json
# Índices de modelos de embeddings alternativos (ex.: API NVIDIA). Só o índice padrão (MiniLM) vai para o
# repositório; para usar outro no Render, gere com "npm run reindex" e adicione com "git add -f".
backend/vector_store_cache.*.json
backend/vector_store_cache*.json.tmp
backend/base_inep_extraida.json.tmp

# Resultados das rodadas do conjunto de avaliação
backend/avaliacao/resultados/

