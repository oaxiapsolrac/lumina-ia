# Modelos Cloud
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Primeiro modelo tentado no /tts (os demais são fallback fixo no código)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_REASONING_EFFORT=low

GPT_OSS_API_KEY=
GPT_OSS_MODEL=openai/gpt-oss-20b

NVIDIA_NEMOTRON_120B_API_KEY=
NEMOTRON_120B_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

NVIDIA_NEMOTRON_OMNI_API_KEY=
NEMOTRON_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

MISTRAL_LARGE_API_KEY=
MISTRAL_LARGE_MODEL=mistralai/mistral-large-4-1t-a52b
MISTRAL_REASONING_EFFORT=medium

# SLM Remoto (Ollama via Cloudflare Tunnel)
OLLAMA_ENDPOINT=
QWEN_MODEL=qwen2.5:1.5b
QWEN_NUM_CTX=4096

# Geração (RAG)
# Temperatura usada por todos os modelos nas respostas (0,2 a 0,3 é o indicado para respostas factuais)
RAG_TEMPERATURE=0.3
# Esforço de raciocínio dos modelos GPT-OSS: low | medium | high
GPT_OSS_REASONING_EFFORT=low
# Teto de tokens do histórico enviado ao modelo (nunca ultrapassa a janela do modelo)
HISTORICO_MAX_TOKENS=6000
# Streaming: tempo máximo sem nenhum dado do modelo e tempo máximo da resposta inteira (ms)
LLM_TIMEOUT_INATIVIDADE_MS=90000
LLM_TIMEOUT_TOTAL_MS=300000

# Busca (RAG)
# Onde os embeddings são calculados: local (padrão, no próprio servidor) ou nvidia (API da NVIDIA, usa NVIDIA_API_KEY).
# nvidia: multilíngue e sem modelo na memória do servidor, mas cada pergunta é enviada à NVIDIA (+~350 ms).
# Se a API falhar, a busca segue só por palavras por 1 minuto. Ao trocar, rode "npm run reindex" uma vez
# (gera vector_store_cache.nvidia_nemotron_3_embed_1b.json; com 1377 documentos eram ~15 MB em ~2,5 min,
# e com as bases CEPALSTAT, OECD STIP e World Bank WBL são 2595 documentos). Esse arquivo não vai para o
# repositório por padrão: para usá-lo no Render, adicione com "git add -f" (senão o servidor reindexa ao subir).
EMBEDDING_PROVIDER=local
# Modelo do provedor escolhido. Vazio = Xenova/all-MiniLM-L6-v2 (local) ou nvidia/nemotron-3-embed-1b (nvidia).
# Local alternativo: Xenova/multilingual-e5-small (melhor em português, mas ~700 MB de RAM: não cabe no Render gratuito).
EMBEDDING_MODEL=
# Só para nvidia: números por vetor guardados (1024 tem a mesma qualidade de 2048 no conjunto de avaliação)
EMBEDDING_DIMENSOES=1024
# Só para nvidia: tempo máximo de espera pelo vetor da pergunta antes de buscar só por palavras (ms)
EMBEDDING_API_TIMEOUT_MS=5000
# Peso da busca por palavras (BM25) somado à similaridade vetorial. 0 desliga.
BUSCA_PESO_LEXICO=0.25
# Corte de relevância: só vão ao modelo os documentos com nota de pelo menos esta fração da nota do 1º.
# Vazio = 0,75 (local) ou 0,65 (nvidia). 0 desliga.
BUSCA_CORTE_RELATIVO=
# Quanto os indicadores numéricos perdem de nota quando a pergunta não pede número ("O que a Argentina faz...").
# Evita que os indicadores (UNESCO, RICYT e CEPALSTAT, cerca de 80 por país) tomem o lugar de políticas e iniciativas.
# Vazio = 0,15. 0 desliga.
BUSCA_PENALIDADE_ESTATISTICA=
# Quanto perdem de nota, quando a pergunta fala de mulheres ou gênero, os documentos que não tratam de gênero
# (políticas de carreira do OECD STIP sem recorte de gênero, indicadores da CEPALSTAT que não separam por sexo).
# Vazio = 0,25. 0 desliga.
BUSCA_PENALIDADE_SEM_GENERO=

# Servidor
PORT_TESTE=3001

# Proteções de acesso (recomendado definir no Render)
# Origens autorizadas a chamar a API, separadas por vírgula. Vazio = qualquer origem.
# No Render, use o endereço do novo design no Vercel (ex.: https://lumina-novodesign.vercel.app).
# Para testar o novodesign na máquina, acrescente http://localhost:5173
CORS_ORIGINS=
# Requisições por IP em /chat, /chat/stream, /search e /tts por janela. 0 desliga.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Tamanho máximo do corpo da requisição (anexos em base64)
BODY_LIMIT=25mb
# Número de proxies na frente do servidor. No Render já é 1 automaticamente.
TRUST_PROXY=
# Habilita POST /reindex (Authorization: Bearer <token>). Vazio = rota desabilitada.
ADMIN_TOKEN=

# Fontes da reindexação (opcionais; por padrão procura ao lado do backend e em ../../conhecimento.js)
CONHECIMENTO_PATH=
TTL_PATH=

# GraphDB do ELLAS (lido só por "npm run extrair:inep", não pelo servidor)
ELLAS_ENDPOINT=https://app.ellas.ufmt.br/repositories/EllasV2
ELLAS_INEP_ENDPOINT=https://app.ellas.ufmt.br/repositories/ELLAS-INEP-V1
ELLAS_AUTH_BASE64=
