# Modelos Cloud
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Primeiro modelo tentado no /tts (os demais são fallback fixo no código)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_REASONING_EFFORT=low

GPT_OSS_API_KEY=
GPT_OSS_MODEL=openai/gpt-oss-20b

NVIDIA_NEMOTRON_120B_API_KEY=
NEMOTRON_120B_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

NVIDIA_NEMOTRON_OMNI_API_KEY=
NEMOTRON_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

MISTRAL_LARGE_API_KEY=
MISTRAL_LARGE_MODEL=mistralai/mistral-large-4-1t-a52b
MISTRAL_REASONING_EFFORT=medium

# SLM Remoto (Ollama via Cloudflare Tunnel)
OLLAMA_ENDPOINT=
QWEN_MODEL=qwen2.5:1.5b
QWEN_NUM_CTX=4096

# Servidor
PORT_TESTE=3001

# Proteções de acesso (recomendado definir no Render)
# Origens autorizadas a chamar a API, separadas por vírgula. Vazio = qualquer origem.
# No Render, use: https://lumina-ia-nu.vercel.app (acrescente "null" para testar abrindo o index.html direto do disco)
CORS_ORIGINS=
# Requisições por IP em /chat, /chat/stream, /search e /tts por janela. 0 desliga.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Tamanho máximo do corpo da requisição (anexos em base64)
BODY_LIMIT=25mb
# Número de proxies na frente do servidor. No Render já é 1 automaticamente.
TRUST_PROXY=
# Habilita POST /reindex (Authorization: Bearer <token>). Vazio = rota desabilitada.
ADMIN_TOKEN=

# Fontes da reindexação (opcionais; por padrão procura ao lado do backend e em ../../conhecimento.js)
CONHECIMENTO_PATH=
TTL_PATH=

# Integração ELLAS (não lido pelo server_vetorial.js; mantido para a integração com o GraphDB)
ELLAS_ENDPOINT=https://app.ellas.ufmt.br/repositories/EllasV2
ELLAS_AUTH_BASE64=
